# Dinner Bell settings. Copy to .env for local development (`just setup` does this); never
# commit .env. In production, set these as Portainer stack variables (docs/DEPLOY.md).

# The address phones use. In development it is the Vite dev server, which proxies /api.
APP_BASE_URL=http://localhost:5173
# A long random value: openssl rand -base64 48. Changing it signs every device out.
APP_SECRET_KEY=change-me-to-a-long-random-string
# The household passphrase, 12 characters or more.
APP_PASSWORD=change-me-household-passphrase
# IANA time zone, used for "Tonight" and the 03:30 nightly backup.
TZ=America/New_York
PORT=8080
# Your reverse proxy's IPs or CIDRs, comma-separated. Leave empty when not behind a proxy.
TRUSTED_PROXIES=
# fake = synthetic sample products; live = the real Kroger API (needs the two keys below).
KROGER_MODE=fake
KROGER_CLIENT_ID=
KROGER_CLIENT_SECRET=
# Only for `just smoke-kroger`: a 5-digit ZIP near your store. It stays here; nothing prints it.
KROGER_SMOKE_ZIP=
# From M5: must equal APP_BASE_URL + /api/kroger/callback.
KROGER_REDIRECT_URI=
LOG_LEVEL=INFO
# Development only (relative to backend/). In the container this is /data.
DATA_DIR=./.data
